# Lead webhook (required on Netlify — POST to n8n with five keys incl. domain)
Lead_notification_url=
# LEAD_NOTIFICATION_URL=

# Canonical site URL — used to derive `domain` in webhook payload (www stripped)
NEXT_PUBLIC_SITE_URL=https://www.disputeaccounting.com

# Optional: Google Sheets backup via /api/contact (one shared tab; Form Type column)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=Sheet1

# Analytics (loaded only after consent; Analytics category)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_HOTJAR_ID=

# Marketing (loaded only after consent; Marketing category)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Netlify → Site settings → Environment variables:
#   Lead_notification_url, NEXT_PUBLIC_SITE_URL (required for webhook + domain)
# Local testing: `netlify dev` → http://localhost:8888 (redirects /api/submit-lead to function)
