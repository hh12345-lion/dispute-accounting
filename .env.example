# Google Sheets (contact form rows; share sheet with service account as Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=Sheet11

# Lead webhook (optional n8n; four keys: Full Name, Email, Phone Number, Brand name)
Lead_notification_url=
# LEAD_NOTIFICATION_URL=

# Optional: Formspree fallback when Sheets/webhook are not set (503 from /api/submit-lead)
NEXT_PUBLIC_FORMSPREE_FORM_ID=

NEXT_PUBLIC_SITE_URL=https://www.disputeaccounting.com

# Analytics (loaded only after consent; Analytics category)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_HOTJAR_ID=

# Marketing (loaded only after consent; Marketing category)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Netlify: set GOOGLE_* and Lead_notification_url (or LEAD_NOTIFICATION_URL) in Site settings → Environment variables.
# Build uses @netlify/plugin-nextjs; /api/submit-lead runs as a Next.js route on deploy.
