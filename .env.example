# Lead webhook (n8n — five keys incl. domain)
Lead_notification_url=
# LEAD_NOTIFICATION_URL=

NEXT_PUBLIC_SITE_URL=https://disputeaccounting.com

# Google Sheets (share spreadsheet with service account as Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=Sheet1

# Netlify env checklist:
# 1. GOOGLE_PRIVATE_KEY — paste full PEM; Netlify accepts multiline OR single line with \n
# 2. GOOGLE_SHEET_TAB_NAME — must match an existing tab name exactly (case-sensitive)
# 3. Share the sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor
# 4. Lead_notification_url — optional; if webhook fails, Sheets still saves the lead
